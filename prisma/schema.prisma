// Bourbon & Oak — e-commerce schema
// Neon Postgres + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Availability {
  IN_STOCK
  LOW_STOCK
  ALLOCATED
  PRE_ORDER
  SOLD_OUT
  ARCHIVED
}

enum ProductionStyle {
  SINGLE_BARREL
  SMALL_BATCH
  BOTTLED_IN_BOND
  BARREL_PROOF
  STANDARD
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  // Hero image for the category landing
  imageUrl    String?
  // Ordering on the shop sidebar
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  subtitle    String?
  description String   @db.Text
  story       String?  @db.Text

  // Pricing — single bottle, optional case-of-N (null = bottle-only allocation)
  bottlePrice    Decimal  @db.Decimal(10, 2)
  casePrice      Decimal? @db.Decimal(10, 2)
  bottlesPerCase Int?
  compareAtPrice Decimal? @db.Decimal(10, 2)

  // Whiskey specs
  ageYears        Int?
  isNAS           Boolean @default(false)
  proof           Decimal @db.Decimal(5, 2)
  abv             Decimal @db.Decimal(5, 2)
  bottleSizeMl    Int     @default(750)

  // Mash bill (percentages — should sum to ~100)
  cornPercent     Int?
  ryePercent      Int?
  wheatPercent    Int?
  maltedBarleyPct Int?

  // Provenance
  distillery     String
  region         String
  state          String?
  masterDistiller String?
  caskType       String?  // e.g. "New American White Oak"
  charLevel      Int?     // 1-4
  finishCask     String?  // e.g. "Sherry", "Port" — null if none
  batchNumber    String?
  barrelNumber   String?
  releaseYear    Int?

  // Production flags
  productionStyle ProductionStyle @default(STANDARD)
  isChillFiltered Boolean         @default(true)
  isLimitedEdition Boolean        @default(false)
  isAllocated      Boolean        @default(false)
  totalBottlesProduced Int?

  // Tasting profile
  nose            String?  @db.Text
  palate          String?  @db.Text
  finish          String?  @db.Text
  flavorTags      String[] @default([])
  servingSuggestion String?
  foodPairings    String?  @db.Text
  videoUrl        String?

  // Commerce
  sku           String       @unique
  stockBottles  Int          @default(0)
  stockCases    Int          @default(0)
  availability  Availability @default(IN_STOCK)
  rating        Decimal?     @db.Decimal(2, 1)
  reviewCount   Int          @default(0)
  isFeatured    Boolean      @default(false)
  badge         String?      // e.g. "Best Seller", "New Arrival"

  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  awards     Award[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([availability])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Award {
  id           String  @id @default(cuid())
  name         String
  organization String?
  year         Int?
  medal        String? // "Gold", "Double Gold", "Silver"

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Sub-state of PENDING, tracking the manual payment handshake.
//
// The reference machine is AWAITING_DETAILS → DETAILS_SENT → PROOF_SUBMITTED →
// PAID. The first two collapse here: since payment methods carry their own
// instructions (see PaymentOption), details are emailed automatically the
// moment the order is placed, so an order is never sitting in
// "awaiting details" waiting for a human to send them.
//
// This exists alongside OrderStatus rather than inside it because PENDING
// conflates two very different operator situations: "no word from the buyer"
// and "buyer says they paid, go verify it". Those need different queues.
// mark-paid writes both this and OrderStatus in one transaction.
enum SettlementState {
  AWAITING_PAYMENT
  PROOF_SUBMITTED
  PAID
  REJECTED
}

enum PaymentMethod {
  CARD
  PAYPAL
  CHIME
  APPLE_PAY
  CRYPTO
  // Anything the operator adds from the admin panel that isn't one of the
  // built-ins above. The real identity lives in Order.paymentOptionKey /
  // paymentLabel — this enum only exists for the pre-existing orders and
  // the status filters built on top of it.
  OTHER
}

// Operator-managed payment rails. Replaces the hardcoded PAYMENT_OPTIONS array
// that used to live in the checkout client bundle, so account details can be
// changed (or a whole new method added) without a deploy.
//
// `instructions` is the part that actually gets a business paid: the Chime
// handle, the wallet address, the bank details. It is sent to the customer in
// the order email and rendered on the confirmation page.
model PaymentOption {
  id    String @id @default(cuid())
  // Stable slug used by the checkout form and stored on the order.
  key   String @unique
  label String
  // Short line under the label at checkout, e.g. "Pay from your Chime account".
  detail String?
  // The account details / how-to-pay text handed to the customer.
  instructions String? @db.Text
  // Fractional discount for choosing this rail (0.1 = 10% off). Resolved
  // server-side at order time — never trusted from the client.
  discountRate Decimal @default(0) @db.Decimal(4, 3)
  // Maps to the legacy enum so existing reporting keeps working. Null for
  // operator-created rails, which record OTHER on the order.
  legacyMethod PaymentMethod?
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  OVERNIGHT
  WHITE_GLOVE
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  // Contact. `email` stays denormalised on the order so historical orders keep
  // the address they were placed with even if the customer later changes it.
  email String
  phone String

  // Set when the order is placed; links guest checkout to the auto-created
  // account. Nullable for orders that predate customer accounts.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Shipping address
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  postal       String
  country      String

  // Methods
  shippingMethod ShippingMethod
  shippingCost   Decimal        @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  discountRate   Decimal        @db.Decimal(4, 3) @default(0)

  // Snapshot of the payment rail as it was when the order was placed. Kept
  // separate from PaymentOption so that editing a wallet address later can
  // never rewrite what an earlier customer was actually told to pay.
  paymentOptionKey    String?
  paymentLabel        String?
  paymentInstructions String? @db.Text

  // --- Manual settlement (P12) -------------------------------------------
  settlementState SettlementState @default(AWAITING_PAYMENT)
  // What the buyer sent us: txid, Chime confirmation, Zelle reference.
  // Without this, "PAID" is an assertion with nothing behind it.
  paymentReference String?
  // What actually landed, which is not always what was owed.
  amountReceived   Decimal? @db.Decimal(10, 2)
  // Rejection reason, or any operator note about the payment.
  settlementNote   String?  @db.Text
  // Who confirmed and when. Until admin accounts exist (P01) this records a
  // constant, but the columns are here so history is not lost in the meantime.
  settlementUpdatedAt DateTime?
  settlementUpdatedBy String?

  // Buyer-uploaded proof of payment. Only the Cloudinary public id is stored:
  // the asset is uploaded as `authenticated`, so it has no public URL and the
  // admin view signs a short-lived one at render time. A screenshot of a bank
  // transfer routinely shows a balance or an account number, so it must not
  // sit on a permanent public link.
  paymentProofPublicId   String?
  paymentProofUploadedAt DateTime?

  // Totals snapshot
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @db.Decimal(10, 2) @default(0)
  tax      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  notes String? @db.Text

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([settlementState])
  @@index([customerId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Snapshot at order time
  productId    String?
  productName  String
  productImage String
  ageLabel     String?
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  isCase       Boolean @default(false)

  @@index([orderId])
  @@index([productId])
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model Subscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  status    SubscriberStatus @default(SUBSCRIBED)
  source    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Which browsing session handed this address over. SetNull rather than
  // Cascade: losing the visitor record must never lose the subscriber.
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model ContactMessage {
  id      String        @id @default(cuid())
  name    String
  email   String
  subject String?
  body    String        @db.Text
  status  MessageStatus @default(UNREAD)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  // true = a logged-in admin device that should receive live-chat pings.
  // false = a storefront visitor who opted into product announcements.
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([isAdmin])
}

enum ChatSender {
  VISITOR
  ADMIN
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Conversation {
  id        String             @id @default(cuid())
  // The bol_vid visitor cookie value — ties the thread to a device.
  visitorId String
  status    ConversationStatus @default(OPEN)

  // Denormalized for fast inbox sorting + unread badges without scanning messages.
  lastMessageAt   DateTime @default(now())
  lastMessageFrom ChatSender @default(VISITOR)
  // Count of visitor messages the admin hasn't opened yet.
  adminUnread     Int      @default(0)
  // Last time we emailed the admin about this thread — throttles the email
  // fallback so rapid-fire messages don't flood the inbox.
  lastNotifiedAt  DateTime?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitorId])
  @@index([status])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatSender
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// Small key-value store for admin-editable config (e.g. the live-chat greeting).
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Storefront customer. Created automatically the first time an email places an
// order — there is no sign-up flow.
//
// NOTE ON AUTH: sign-in currently accepts an email address with no
// verification, by explicit product decision. That means possession of an
// email string grants access to that person's address, phone and order
// history. The session mechanism below (random DB-backed token) is deliberately
// independent of how the session is *granted*, so adding a verification step
// later — magic link, OTP — only changes the login route, not this model, the
// session table, or any page that reads it.
model Customer {
  id    String @id @default(cuid())
  // Always stored lowercase; the login and order paths both normalise.
  email String @unique

  // Prefill details, refreshed from each order the customer places.
  fullName     String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postal       String?
  country      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  orders   Order[]
  sessions CustomerSession[]

  @@index([createdAt])
}

// Opaque server-side sessions. The cookie carries only a random token, so a
// session can be revoked and nothing about the customer is derivable from it.
model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model Visitor {
  // `id` is the visitor cookie value (UUID). Re-using the cookie keeps
  // someone "one unique" across visits even if their IP changes.
  id          String   @id
  country     String?
  countryCode String?  // ISO-3166-1 alpha-2
  region      String?
  city        String?
  userAgent   String?  @db.Text
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  // Set once the anonymous device behind `id` hands over an email (newsletter
  // popup, footer form). This is what turns "visitor 4F2A" into a real person
  // whose earlier, pre-signup browsing is already on record.
  email          String?
  emailCapturedAt DateTime?

  visitDays   VisitDay[]
  pageViews   PageView[]
  subscribers Subscriber[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([countryCode])
  @@index([email])
}

model VisitDay {
  id        String   @id @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  // `date` is normalized to UTC midnight so we get one row per visitor per day.
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([visitorId, date])
  @@index([date])
}

// One row per page a visitor lands on. Unlike VisitDay this is deliberately
// NOT deduped — the sequence and the repeat hits are the point, since that's
// what shows the path someone took through the site.
model PageView {
  id        String   @id @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  // Pathname only, no query string or hash — keeps cardinality sane so the
  // "top pages" rollup stays meaningful.
  path      String
  createdAt DateTime @default(now())

  // Rollups filter by time; journeys read one visitor in chronological order.
  @@index([createdAt])
  @@index([path])
  @@index([visitorId, createdAt])
}
